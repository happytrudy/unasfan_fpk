#!/bin/bash
set -u

FANCTL_BIN="${TRIM_APPDEST}/bin/superio-fanctl"
DAEMON_BIN="${TRIM_APPDEST}/bin/fan-daemon"
LOG_FILE="${TRIM_PKGVAR}/fancontrol.log"
PID_FILE="${TRIM_PKGVAR}/fancontrol.pid"
TEMP_PATH="${temp_path:-/sys/class/thermal/thermal_zone1/temp}"
POLL_SECONDS="${poll_seconds:-2}"
SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")

log_msg() {
    mkdir -p "${TRIM_PKGVAR}"
    printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"${LOG_FILE}"
}

valid_number() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

read_pid() {
    [ -r "${PID_FILE}" ] || return 1
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    valid_number "${pid}" || return 1
    printf '%s\n' "${pid}"
}

status() {
    local current_pid
    current_pid=$(read_pid) || return 1
    kill -0 "${current_pid}" 2>/dev/null
}

ensure_i2c_dev() {
    [ -d /sys/class/i2c-dev ] && return 0
    if command -v modprobe >/dev/null 2>&1; then
        modprobe i2c-dev >/dev/null 2>&1 || true
    fi
    [ -d /sys/class/i2c-dev ] || {
        log_msg 'i2c-dev is unavailable; official I801 fan control cannot start'
        return 1
    }
}

start_process() {
    status && return 0
    valid_number "${POLL_SECONDS}" || { log_msg 'Invalid poll_seconds'; return 1; }
    [ "${POLL_SECONDS}" -ge 1 ] || { log_msg 'poll_seconds must be at least 1'; return 1; }
    [ -x "${FANCTL_BIN}" ] || { log_msg "Fan controller not found: ${FANCTL_BIN}"; return 1; }
    [ -x "${DAEMON_BIN}" ] || { log_msg "Daemon not found: ${DAEMON_BIN}"; return 1; }
    [ -r "${TEMP_PATH}" ] || { log_msg "Temperature path not readable: ${TEMP_PATH}"; return 1; }
    ensure_i2c_dev || return 1
    mkdir -p "${TRIM_PKGVAR}"
    nohup "${SCRIPT_PATH}" --daemon >/dev/null 2>&1 </dev/null &
    printf '%s\n' "$!" >"${PID_FILE}"
    sleep 1
    status || { rm -f "${PID_FILE}"; log_msg 'Fan control exited immediately'; return 1; }
}

stop_process() {
    local current_pid
    current_pid=$(read_pid) || { rm -f "${PID_FILE}"; return 0; }
    kill -TERM "${current_pid}" 2>/dev/null || true
    sleep 2
    if kill -0 "${current_pid}" 2>/dev/null; then kill -KILL "${current_pid}" 2>/dev/null || true; fi
    rm -f "${PID_FILE}"
}

case "${1:-}" in
    --daemon) exec "${DAEMON_BIN}" ;;
    start) start_process ;;
    stop) stop_process ;;
    restart) stop_process; start_process ;;
    status) status; exit $? ;;
    log) [ -r "${LOG_FILE}" ] && tail -n 200 "${LOG_FILE}" || printf '%s\n' 'No log is available yet.' ;;
    *) printf 'Usage: %s {start|stop|restart|status|log}\n' "$0" >&2; exit 1 ;;
esac
